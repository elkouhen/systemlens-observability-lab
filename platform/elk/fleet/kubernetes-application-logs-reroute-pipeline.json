{
  "description": "Route les logs applicatifs Kubernetes par cluster et environnement",
  "processors": [
    {
      "set": {
        "tag": "set-kubernetes-application-logs-namespace",
        "if": "ctx.service != null && ctx.service.environment != null && ctx.service.environment != ''",
        "field": "data_stream.namespace",
        "value": "local-{{{service.environment}}}"
      }
    },
    {
      "reroute": {
        "tag": "route-kubernetes-application-logs-by-cluster-and-environment",
        "if": "ctx.service != null && ctx.service.environment != null && ctx.service.environment != ''",
        "dataset": "kubernetes.container_logs",
        "namespace": "{{{data_stream.namespace}}}"
      }
    }
  ]
}
