{
  "name": "postgresql-fleet",
  "description": "Métriques PostgreSQL du POC sur data-01 (logs gérés par Filebeat)",
  "namespace": "default",
  "policy_ids": ["mongodb-hosts"],
  "package": {
    "name": "postgresql",
    "title": "PostgreSQL",
    "version": "1.32.1"
  },
  "inputs": [
    {
      "type": "logfile",
      "policy_template": "postgresql",
      "enabled": false,
      "vars": {
        "condition": {"type": "text", "value": "${host.name} == \"data-01\""}
      },
      "streams": [
        {
          "enabled": true,
          "data_stream": {"type": "logs", "dataset": "postgresql.log"},
          "vars": {
            "paths": {"type": "text", "value": ["/var/log/postgresql/*.log"]},
            "tags": {"type": "text", "value": ["postgresql-log"]},
            "preserve_original_event": {"type": "bool", "value": false}
          }
        }
      ]
    },
    {
      "type": "postgresql/metrics",
      "policy_template": "postgresql",
      "enabled": true,
      "vars": {
        "hosts": {"type": "text", "value": ["postgres://localhost:5432/observability_test?sslmode=disable"]},
        "username": {"type": "text", "value": "observability"},
        "password": {"type": "password", "value": "${POSTGRESQL_PASSWORD}"},
        "condition": {"type": "text", "value": "${host.name} == \"data-01\""}
      },
      "streams": [
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "postgresql.activity"}, "vars": {"period": {"type": "text", "value": "60s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "postgresql.bgwriter"}, "vars": {"period": {"type": "text", "value": "60s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "postgresql.database"}, "vars": {"period": {"type": "text", "value": "60s"}}},
        {"enabled": false, "data_stream": {"type": "metrics", "dataset": "postgresql.statement"}, "vars": {"period": {"type": "text", "value": "60s"}}}
      ]
    }
  ]
}
