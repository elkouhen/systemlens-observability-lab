certs/*
!certs/README.md
.vagrant
*/.vagrant

# Sélection locale de l'architecture déployée (v1 par défaut).
.architecture-version
*/.architecture-version

# Artéfacts de compilation Maven, quel que soit le module.
target/

# Métadonnées locales des agents.
.agent/
.agents/
**/.systemlens/findings.db

# Rapport APM généré localement.
/apm.html

# Export local potentiellement sensible ; ne jamais versionner une clé Kibana.
/kibana-key.md

# Certificat racine Zscaler (ou tout proxy TLS d'entreprise) fourni localement.
# Voir certs/README.md : jamais versionné, propre à chaque machine.
certs/*.crt
certs/*.pem
