dist 
node_modules
certs/*
!certs/README.md
.vagrant
*/.vagrant
.vagrant-backups

# Sélection locale de l'architecture déployée (v3).
.architecture-version
*/.architecture-version

# Artéfacts de compilation Maven, quel que soit le module.
target/

# Métadonnées locales des agents.
.agent/
.agents/
**/.systemlens/findings.db
# Métadonnées et bases locales SystemLens générées par les agents.
