global
  log stdout format raw local0
  stats socket /run/haproxy/admin.sock mode 660 user root group haproxy level admin
  stats timeout 30s

defaults
  log global
  timeout connect 5s
  timeout client 30s
  timeout server 30s

frontend otlp_grpc
  bind :4317
  mode tcp
  default_backend otel_gateway_grpc

backend otel_gateway_grpc
  mode tcp
  option tcp-check
  server otel_gateway 127.0.0.1:4320 check

frontend otlp_http
  bind :4318
  mode http
  default_backend otel_gateway_http

backend otel_gateway_http
  mode http
  option tcp-check
  server otel_gateway 127.0.0.1:4319 check
