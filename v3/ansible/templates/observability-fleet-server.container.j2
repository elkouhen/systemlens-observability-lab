[Unit]
Description=Fleet Server du POC
After=network-online.target observability-elasticsearch.service observability-kibana.service
Wants=network-online.target
Requires=observability-elasticsearch.service observability-kibana.service

[Container]
Image=docker.elastic.co/elastic-agent/elastic-agent:9.4.3
ContainerName=observability-fleet-server
Network=host
EnvironmentFile=/etc/observability/fleet-server.env
Volume=/var/lib/observability/fleet-server:/usr/share/elastic-agent/state:Z
Memory=768m
Environment=FLEET_SERVER_ENABLE=true
Environment=FLEET_SERVER_HOST=0.0.0.0
Environment=FLEET_SERVER_PORT=8220
Environment=FLEET_URL={{ fleet_url | default('http://127.0.0.1:8220') }}
Environment=FLEET_SERVER_INSECURE_HTTP=true
Environment=FLEET_SERVER_ELASTICSEARCH_HOST=http://127.0.0.1:9200
Environment=KIBANA_HOST=http://127.0.0.1:5601
Environment=KIBANA_FLEET_SETUP=1
Environment=FLEET_SERVER_POLICY_ID=eck-fleet-server

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
