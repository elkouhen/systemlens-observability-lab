global
  log stdout format raw local0
  stats socket /run/haproxy/admin.sock mode 660 user root group haproxy level admin
  stats timeout 30s

defaults
  log global
  timeout connect 5s
  timeout client 60s
  timeout server 60s

frontend otlp_grpc
  bind :4317
  mode tcp
  default_backend otel_backend_grpc

backend otel_backend_grpc
  mode tcp
  server otel_backend {{ otel_backend_ip }}:4320

frontend otlp_http
  bind :4318
  mode tcp
  default_backend otel_backend_http

backend otel_backend_http
  mode tcp
  server otel_backend {{ otel_backend_ip }}:4319

frontend elasticsearch
  bind :9200
  mode http
  default_backend elasticsearch_backend

backend elasticsearch_backend
  mode http
  server elk {{ elk_ip }}:9200 check

frontend kibana
  bind :5601
  mode http
  default_backend kibana_backend

backend kibana_backend
  mode http
  server elk {{ elk_ip }}:5601 check

frontend fleet
  bind :8220
  mode http
  default_backend fleet_backend

backend fleet_backend
  mode http
  server elk {{ elk_ip }}:8220 check
