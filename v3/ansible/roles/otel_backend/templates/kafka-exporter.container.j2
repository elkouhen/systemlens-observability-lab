[Unit]
Description=Exporteur Elastic OpenTelemetry depuis Kafka du POC
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.elastic.co/elastic-agent/elastic-otel-collector:9.4.3
ContainerName=observability-otel-kafka-exporter
Network=host
EnvironmentFile=/etc/observability/otel-kafka-exporter.env
Volume=/etc/observability/otel-kafka-exporter.yaml:/etc/otel/collector.yaml:ro,Z
Volume=/var/lib/observability/otel-kafka-exporter:/var/lib/otel:Z
Memory=1536m
Exec=--config=/etc/otel/collector.yaml

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
