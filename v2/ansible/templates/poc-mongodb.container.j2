[Unit]
Description=MongoDB POC{% if poc_distributed | bool %} replica set{% else %} standalone{% endif %}
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/library/mongo:8.0
ContainerName=poc-mongodb
PublishPort=27017:27017
Volume=mongodb-data:/data/db:Z
Volume=/var/log/mongodb:/var/log/mongodb:Z
Memory=512m
Exec=mongod{% if poc_distributed | bool %} --replSet {{ mongodb_replica_set }}{% endif %} --bind_ip_all --wiredTigerCacheSizeGB 0.25 --logpath /var/log/mongodb/mongod.log --logappend

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
