extensions:
  file_storage:
    directory: /var/lib/poc-otel-agent
  health_check:
    endpoint: 127.0.0.1:13133

receivers:
  filelog/vm:
    include:
      - /var/log/messages
      - /var/log/secure
      - /var/log/kafka/*.log
      - /var/log/mongodb/*.log
      - /var/log/postgresql/*.log
    exclude:
      - /var/log/**/*.gz
    start_at: end
    include_file_path: true
    include_file_name: true
  hostmetrics:
    collection_interval: 30s
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization:
            enabled: true
      disk: {}
      filesystem: {}
      load: {}
      memory:
        metrics:
          system.memory.utilization:
            enabled: true
      network: {}
      paging: {}
      processes: {}
  kafka_metrics:
    brokers:
      - 127.0.0.1:9092
    protocol_version: 3.9.0
    collection_interval: 60s
    scrapers:
      - brokers
      - topics
      - consumers
  mongodb:
    hosts:
      - endpoint: 127.0.0.1:27017
    direct_connection: true
    collection_interval: 60s
    tls:
      insecure: true
{% if inventory_hostname == 'data-01' %}
  postgresql:
    endpoint: 127.0.0.1:5432
    username: {{ postgresql_user }}
    password: '{{ postgresql_password }}'
    databases:
      - {{ postgresql_database }}
    collection_interval: 60s
    tls:
      insecure: true
{% endif %}

processors:
  resourcedetection/system:
    detectors: [system]
    system:
      hostname_sources: [os]
  resource/vm:
    attributes:
      - key: deployment.environment.name
        value: v2
        action: upsert
      - key: service.namespace
        value: poc-vm
        action: upsert
  resource/kafka:
    attributes:
      - key: service.name
        value: kafka
        action: upsert
      - key: data_stream.dataset
        value: kafka
        action: upsert
  resource/mongodb:
    attributes:
      - key: service.name
        value: mongodb
        action: upsert
      - key: data_stream.dataset
        value: mongodb
        action: upsert
{% if inventory_hostname == 'data-01' %}
  resource/postgresql:
    attributes:
      - key: service.name
        value: postgresql
        action: upsert
      - key: data_stream.dataset
        value: postgresql
        action: upsert
{% endif %}
  memory_limiter:
    check_interval: 1s
    limit_mib: 256
    spike_limit_mib: 64
  batch:
    timeout: 1s
    send_batch_size: 256

exporters:
  kafka/vm:
    brokers:
      - 192.168.33.10:9092
      - 192.168.33.11:9092
      - 192.168.33.12:9092
    protocol_version: 3.9.0
    logs:
      topic: edot-vm-logs
      encoding: otlp_proto
    metrics:
      topic: edot-vm-metrics
      encoding: otlp_proto
    sending_queue:
      enabled: true
      storage: file_storage
    retry_on_failure:
      enabled: true

service:
  extensions: [file_storage, health_check]
  pipelines:
    logs:
      receivers: [filelog/vm]
      processors: [resourcedetection/system, resource/vm, memory_limiter, batch]
      exporters: [kafka/vm]
    metrics:
      receivers: [hostmetrics]
      processors: [resourcedetection/system, resource/vm, memory_limiter, batch]
      exporters: [kafka/vm]
    metrics/kafka:
      receivers: [kafka_metrics]
      processors: [resourcedetection/system, resource/vm, resource/kafka, memory_limiter, batch]
      exporters: [kafka/vm]
    metrics/mongodb:
      receivers: [mongodb]
      processors: [resourcedetection/system, resource/vm, resource/mongodb, memory_limiter, batch]
      exporters: [kafka/vm]
{% if inventory_hostname == 'data-01' %}
    metrics/postgresql:
      receivers: [postgresql]
      processors: [resourcedetection/system, resource/vm, resource/postgresql, memory_limiter, batch]
      exporters: [kafka/vm]
{% endif %}
