filebeat.inputs:
  - type: filestream
    id: rocky-system-logs
    paths:
      - /var/log/messages*
      - /var/log/secure*
    exclude_files: ['\\.gz$']
    fields_under_root: true
    fields:
      event.dataset: system.syslog
      data_stream.type: logs
      data_stream.dataset: system.syslog
      data_stream.namespace: default
  - type: filestream
    id: mongodb-logs
    paths: [/var/log/mongodb/mongod.log]
    fields_under_root: true
    fields:
      event.dataset: mongodb.log
      data_stream.type: logs
      data_stream.dataset: mongodb.log
      data_stream.namespace: default
  - type: filestream
    id: kafka-logs
    paths: [/var/log/kafka/*.log]
    fields_under_root: true
    fields:
      event.dataset: kafka.log
      data_stream.type: logs
      data_stream.dataset: kafka.log
      data_stream.namespace: default
{% if inventory_hostname == 'data-01' %}
  - type: filestream
    id: postgresql-logs
    paths: [/var/log/postgresql/*.log]
    fields_under_root: true
    fields:
      event.dataset: postgresql.log
      data_stream.type: logs
      data_stream.dataset: postgresql.log
      data_stream.namespace: default
{% endif %}

processors:
  - add_host_metadata: ~

# Les index de ce POC sont sélectionnés explicitement ci-dessous. Filebeat ne
# doit donc ni installer de template ni vérifier/créer sa policy ILM générique.
# Cette vérification bloquait toute publication avec une clé d'écriture limitée
# qui ne possède pas le privilège `read_ilm`.
setup.template.enabled: false
setup.ilm.enabled: false

output.elasticsearch:
  hosts: ["{{ elasticsearch_url }}"]
  api_key: "{{ elasticsearch_api_key }}"
  # Une règle par dataset est nécessaire : le champ data_stream.dataset seul ne
  # pilote pas le choix du data stream de sortie par Filebeat.
  indices:
    - index: "logs-system.syslog-default"
      when.equals:
        event.dataset: "system.syslog"
    - index: "logs-mongodb.log-default"
      when.equals:
        event.dataset: "mongodb.log"
    - index: "logs-kafka.log-default"
      when.equals:
        event.dataset: "kafka.log"
    - index: "logs-postgresql.log-default"
      when.equals:
        event.dataset: "postgresql.log"
  ssl.certificate_authorities: ["/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"]
