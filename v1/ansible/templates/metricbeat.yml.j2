metricbeat.modules:
  - module: system
    period: 30s
    metricsets: [cpu, load, memory, network, process_summary, uptime]
  - module: system
    period: 1m
    metricsets: [filesystem, fsstat]
    processors:
      - drop_event.when.regexp:
          system.filesystem.mount_point: '^/(sys|cgroup|proc|dev|etc|host|lib|snap)($|/)'
  - module: mongodb
    period: 60s
    hosts: ["127.0.0.1:27017"]
    metricsets: [collstats, dbstats, metrics, replstatus, status]
  - module: kafka
    period: 60s
    hosts: ["http://127.0.0.1:8778"]
    metricsets: [broker]
  - module: kafka
    period: 60s
    hosts: ["127.0.0.1:9092"]
    metricsets: [partition, consumergroup]
processors:
  - add_host_metadata: ~

# Les assets Fleet possèdent déjà les templates et pipelines des data streams
# `metrics-*`. Éviter le data stream historique `metricbeat-*`, qui n'est pas
# consommé par les dashboards System, et ne pas installer les assets génériques
# Metricbeat avec une clé d'écriture limitée.
setup.template.enabled: false
setup.ilm.enabled: false

output.logstash:
  hosts: ["{{ logstash_url }}"]
  ssl.enabled: true
  ssl.certificate_authorities: ["/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"]
