direction: right

classes: {
  lane: {
    style.fill: "#f8fafc"
    style.stroke: "#94a3b8"
    style.border-radius: 14
    style.font-size: 18
  }
  source: {style.fill: "#eef2ff"; style.stroke: "#6366f1"; style.border-radius: 10}
  gateway: {style.fill: "#eff6ff"; style.stroke: "#2563eb"; style.border-radius: 10}
  transport: {style.fill: "#fff7ed"; style.stroke: "#ea8b2d"; style.border-radius: 10}
  store: {style.fill: "#ecfdf5"; style.stroke: "#16a34a"; style.border-radius: 10}
}

sources: "Sources" {
  class: lane
  direction: down
  client: "Client\nHTTP" {class: source}
  service: "Service Java\ntrace.id · span.id" {class: source}
}

collect: "Collecte OTLP" {
  class: lane
  direction: down
  gateway: "Gateway OTLP" {class: gateway}
  edge: "Gateway Edge" {class: gateway}
}

transport: "Transport Kafka" {
  class: lane
  direction: down
  kafka: "Kafka\notel-traces" {class: transport}
  backend: "Gateway Backend\nexport" {class: gateway}
}

apm: "Consultation APM" {
  class: lane
  direction: down
  server: "APM Server" {class: store}
  kibana: "Kibana APM\nservices · transactions · traces" {class: store}
}

sources.client -> sources.service: "HTTP"
sources.service -> collect.gateway: "spans OTLP"
collect.gateway -> collect.edge: "OTLP"
collect.edge -> transport.kafka: "publication"
transport.kafka -> transport.backend: "consommation"
transport.backend -> apm.server: "export"
apm.server -> apm.kibana
