direction: right

classes: {
  lane: {
    style.fill: "#f8fafc"
    style.stroke: "#94a3b8"
    style.border-radius: 14
    style.font-size: 18
  }
  source: {style.fill: "#eef2ff"; style.stroke: "#6366f1"; style.border-radius: 10}
  gateway: {style.fill: "#eff6ff"; style.stroke: "#2563eb"; style.border-radius: 10}
  transport: {style.fill: "#fff7ed"; style.stroke: "#ea8b2d"; style.border-radius: 10}
  store: {style.fill: "#ecfdf5"; style.stroke: "#16a34a"; style.border-radius: 10}
}

kubernetes: "Kubernetes" {
  class: lane
  direction: down
  app: "Applications Java" {class: source}
  node: "EDOT node collector\nlogs · hostmetrics · kubeletstats" {class: gateway}
  cluster: "EDOT cluster collector\nk8s_cluster" {class: gateway}
  gateway: "Gateway OTLP\n4317 / 4318" {class: gateway}
  app -> node: "stdout logs"
  app -> gateway: "traces · metrics"
  cluster -> gateway: "cluster metrics"
  node -> gateway
}

edge: "Collecte Edge" {
  class: lane
  direction: down
  gateway: "Gateway Edge\nHAProxy · OTLP" {class: gateway}
  databases: "PostgreSQL · MongoDB" {class: source}
  databases -> gateway: "logs · metrics"
}

transport: "Transport" {
  class: lane
  direction: down
  kafka: "Kafka\notel-traces · otel-metrics · otel-logs" {class: transport}
  backend: "Gateway Backend\nKafka exporter EDOT" {class: gateway}
  kafka -> backend: "consume"
}

elastic: "Elastic" {
  class: lane
  direction: down
  elasticsearch: "Elasticsearch\nmetrics · logs" {class: store}
  apm: "APM Server\ntraces" {class: store}
  kibana: "Kibana\ndashboards · APM" {class: store}
  elasticsearch -> kibana
  apm -> kibana
}

kubernetes.gateway -> edge.gateway: "OTLP"
edge.gateway -> transport.kafka: "publish by signal"
transport.backend -> elastic.elasticsearch: "metrics · logs"
transport.backend -> elastic.apm: "traces"
