direction: right

classes: {
  lane: {
    style.fill: "#f8fafc"
    style.stroke: "#94a3b8"
    style.border-radius: 14
    style.font-size: 18
  }
  source: {style.fill: "#eef2ff"; style.stroke: "#6366f1"; style.border-radius: 10}
  gateway: {style.fill: "#eff6ff"; style.stroke: "#2563eb"; style.border-radius: 10}
  transport: {style.fill: "#fff7ed"; style.stroke: "#ea8b2d"; style.border-radius: 10}
  store: {style.fill: "#ecfdf5"; style.stroke: "#16a34a"; style.border-radius: 10}
}

sources: "Sources" {
  class: lane
  direction: down
  pods: "Pods\nstdout · logs applicatifs" {class: source}
  vm: "VM et services\nlogs locaux" {class: source}
}

collect: "Collecte EDOT" {
  class: lane
  direction: down
  node: "EDOT node collector\nfileread · enrichissement" {class: gateway}
  edge: "Gateway Edge\nOTLP" {class: gateway}
}

transport: "Transport Kafka" {
  class: lane
  direction: down
  kafka: "Kafka\notel-logs" {class: transport}
  backend: "Gateway Backend\nconsommation" {class: gateway}
}

storage: "Stockage" {
  class: lane
  elastic: "Elasticsearch\nlogs-* · indexation" {class: store}
}

sources.pods -> collect.node: "lecture"
sources.vm -> collect.edge: "OTLP via EDOT standalone"
collect.node -> collect.edge: "OTLP"
collect.edge -> transport.kafka: "publication"
transport.kafka -> transport.backend: "consommation"
transport.backend -> storage.elastic: "indexation"
