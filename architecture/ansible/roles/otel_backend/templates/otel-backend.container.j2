[Unit]
Description=Collecteur backend Elastic OpenTelemetry du lab
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.elastic.co/elastic-agent/elastic-otel-collector:9.5.4
ContainerName=observability-otel-backend
Network=host
EnvironmentFile=/etc/observability/otel-backend.env
Volume=/etc/observability/otel-backend.yaml:/etc/otel/collector.yaml:ro,Z
Volume=/var/lib/observability/otel-backend:/var/lib/otel:Z
Exec=--config=/etc/otel/collector.yaml

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
