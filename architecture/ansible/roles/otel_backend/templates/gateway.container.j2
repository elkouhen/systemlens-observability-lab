[Unit]
Description=Gateway Elastic OpenTelemetry du POC
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.elastic.co/elastic-agent/elastic-otel-collector:9.4.3
ContainerName=observability-otel-gateway
Network=host
Volume=/etc/observability/otel-gateway.yaml:/etc/otel/collector.yaml:ro,Z
Memory=512m
Exec=--config=/etc/otel/collector.yaml

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
