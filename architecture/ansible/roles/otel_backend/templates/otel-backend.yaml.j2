extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 0.0.0.0:13134
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/otel

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/kafkareceiver
  kafka/otlp:
    brokers: ["{{ otel_kafka_broker }}"]
    # Pas de protocol_version (ADR-013) : franz-go négocie avec le broker la
    # version de chaque requête (ApiVersions). Une valeur fixée borne à la
    # fois le minimum et le maximum de chaque requête à cette version.
    group_id: otel-backend
    # Souscription par expression régulière (un topic commençant par « ^ »
    # est interprété comme une regex) : un topic par plateforme et
    # environnement, otel-<signal>-<plateforme>-<environnement> (ADR-015).
    # Les nouveaux topics sont découverts à chaque rafraîchissement des
    # métadonnées, sans redémarrage du collecteur.
{% if otel_backend_legacy_topics | default(false) %}
    # Transition ADR-015 : les anciens topics otel-<signal> et
    # otel-<signal>-homologation sont lus jusqu'à leur suppression.
{% endif %}
{% for signal in ['traces', 'metrics', 'logs'] %}
    {{ signal }}:
      topics: ["^otel-{{ signal }}-[a-z0-9_]+-[a-z0-9_]+$"{% if otel_backend_legacy_topics | default(false) %}, "^otel-{{ signal }}(-homologation)?$"{% endif %}]
      encoding: otlp_proto
{% endfor %}
    # Une partition sans offset commité (topic nouvellement découvert) est
    # lue depuis le début : les premiers messages publiés avant la découverte
    # ne sont pas perdus. Les partitions déjà commitées reprennent à leur offset.
    initial_offset: earliest
    metadata:
      refresh_interval: 1m
    # Garantie de livraison (ADR-013) : un message n'est marqué, donc son
    # offset commité, qu'après le retour du pipeline, c'est-à-dire après son
    # écriture dans la file persistante de l'exporteur. Une erreur
    # transitoire (file pleine, memory_limiter) laisse le message non marqué
    # et error_backoff le relit. Une erreur permanente (message illisible,
    # rejet définitif) marque le message : il est perdu, mais il ne bloque
    # pas sa partition jusqu'au prochain rebalance.
    message_marking:
      after: true
      on_error: false
      on_permanent_error: true
    error_backoff:
      enabled: true
      initial_interval: 1s
      max_interval: 30s
      max_elapsed_time: 5m
    auth:
      sasl:
        username: "${env:OTEL_KAFKA_CONSUMER_USERNAME}"
        password: "${env:OTEL_KAFKA_CONSUMER_PASSWORD}"
        mechanism: PLAIN

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:4322

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 700
    spike_limit_mib: 150
  cumulativetodelta:
    include:
      metric_types:
        - histogram
  # Seuls les pipelines de télémétrie interne passent par batch. Les
  # pipelines Kafka n'en ont pas : batch acquitte avant l'export et
  # annulerait message_marking.after. Ils sont regroupés par la file de
  # chaque exporteur, après persistance (ADR-013).
  batch:
    timeout: 1s
    send_batch_size: 512
  # Les métriques Java du client Kafka (kafka.consumer.*.avg/.max, agent
  # OpenTelemetry des services) valent NaN tant qu'aucune mesure n'existe.
  # L'exporteur Elasticsearch rejette ces points avec un avertissement
  # « validation errors » ; ils sont supprimés ici, sans autre perte.
  # x - x est différent de 0 seulement pour NaN et ±Inf (ADR-013).
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/filterprocessor
  filter/invalid-double:
    error_mode: ignore
    metric_conditions:
      - (metric.type == METRIC_DATA_TYPE_GAUGE or metric.type == METRIC_DATA_TYPE_SUM) and datapoint.value_double - datapoint.value_double != 0.0
  # Routage par topic (ADR-015) : le nom du topic porte la plateforme et
  # l'environnement. Le receiver Kafka expose le topic d'origine dans le
  # contexte (kafka.topic) ; il est copié en attribut de ressource, car la
  # file de l'exporteur, qui regroupe les lots, ne conserve pas ce contexte.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/resourceprocessor
  resource/kafka-topic:
    attributes:
      - key: otel.kafka.topic
        from_context: metadata.kafka.topic
        action: upsert
  # Routage par plateforme (ADR-015) : le nom du topic,
  # otel-<signal>-<plateforme>-<environnement>, est la preuve de provenance.
  # Le backend en tire platform.id et data_stream.namespace. Le dataset est
  # celui posé par l'Edge pour une application, sinon celui que l'exporteur
  # dérive du receiver. Les traces gardent les datasets apm d'APM Server et
  # reçoivent le namespace <plateforme>_<environnement>, recopié dans
  # apm.route.namespace (label global apm_route_namespace, que le pipeline
  # Elasticsearch apm-route-namespace applique aux métriques APM agrégées
  # puis retire, ADR-010). Un topic hors format ne pose rien.
  # otel.kafka.topic est supprimé ensuite.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/data-stream-route:
    error_mode: ignore
    log_statements: &data_stream_route
      - context: resource
        conditions:
          - IsMatch(resource.attributes["otel.kafka.topic"], "^otel-[a-z]+-[a-z0-9_]+-[a-z0-9_]+$")
        statements:
          - merge_maps(resource.cache, ExtractPatterns(resource.attributes["otel.kafka.topic"], "^otel-[a-z]+-(?P<platform>[a-z0-9_]+)-(?P<namespace>[a-z0-9_]+)$"), "upsert")
          - set(resource.attributes["platform.id"], resource.cache["platform"])
          - set(resource.attributes["data_stream.namespace"], resource.cache["namespace"])
{% if otel_backend_legacy_topics | default(false) %}
      # Transition ADR-015 : ancienne sémantique des topics encore lus, le
      # dataset de l'ancienne route applicative et le namespace de l'ancienne
      # route Kubernetes. Supprimé avec otel_backend_legacy_topics.
      - context: resource
        statements:
          - set(resource.attributes["data_stream.dataset"], "supermarche") where IsMatch(resource.attributes["otel.kafka.topic"], "^otel-[a-z]+-supermarche-homologation$")
          - set(resource.attributes["data_stream.namespace"], "homologation") where IsMatch(resource.attributes["otel.kafka.topic"], "^otel-[a-z]+-homologation$")
{% endif %}
      - context: resource
        statements:
          - delete_key(resource.attributes, "otel.kafka.topic")
    metric_statements: *data_stream_route
    trace_statements:
      - context: resource
        statements:
          # Seul ce collecteur pose le label de routage des agrégats APM.
          - delete_key(resource.attributes, "apm.route.namespace")
      - context: resource
        conditions:
          - IsMatch(resource.attributes["otel.kafka.topic"], "^otel-traces-[a-z0-9_]+-[a-z0-9_]+$")
        statements:
          - merge_maps(resource.cache, ExtractPatterns(resource.attributes["otel.kafka.topic"], "^otel-traces-(?P<platform>[a-z0-9_]+)-(?P<namespace>[a-z0-9_]+)$"), "upsert")
          - set(resource.attributes["platform.id"], resource.cache["platform"])
          - set(resource.attributes["data_stream.namespace"], Concat([resource.cache["platform"], resource.cache["namespace"]], "_"))
          - set(resource.attributes["apm.route.namespace"], resource.attributes["data_stream.namespace"])
{% if otel_backend_legacy_topics | default(false) %}
      - context: resource
        statements:
          - set(resource.attributes["data_stream.namespace"], "homologation") where IsMatch(resource.attributes["otel.kafka.topic"], "^otel-traces-homologation$")
{% endif %}
      - context: resource
        statements:
          - delete_key(resource.attributes, "otel.kafka.topic")
  # Métriques de l'agent Java OTel vers APM Server (ADR-016) : elles suivent le
  # modèle des traces du même service. APM Server les range dans
  # metrics-apm.app.<service>-<plateforme>_<environnement>, lu par l'onglet
  # Metrics de l'UI APM. Le dataset applicatif posé par l'Edge est retiré
  # (APM Server garde apm.app) et le namespace reprend la composition des
  # traces, <plateforme>_<environnement>. Un apm.route.namespace reçu est
  # écarté : seul ce collecteur le pose.
  transform/apm-metrics:
    error_mode: ignore
    metric_statements:
      - context: resource
        statements:
          - delete_key(resource.attributes, "data_stream.dataset")
          - delete_key(resource.attributes, "apm.route.namespace")
      - context: resource
        conditions:
          - resource.attributes["platform.id"] != nil and resource.attributes["data_stream.namespace"] != nil
        statements:
          - set(resource.attributes["data_stream.namespace"], Concat([resource.attributes["platform.id"], resource.attributes["data_stream.namespace"]], "_"))
          # APM Server calcule aussi des agrégats (service_summary) depuis les
          # métriques : le label de routage les range dans le namespace des
          # traces (ADR-010), comme pour les agrégats issus des traces.
          - set(resource.attributes["apm.route.namespace"], resource.attributes["data_stream.namespace"])

connectors:
  # Partage du flux de métriques (ADR-016). Les métriques des scopes
  # io.opentelemetry.* sont émises par l'agent Java OTel (runtime JVM,
  # instrumentation HTTP, SDK) : elles vont à APM Server. Toutes les autres
  # (Micrometer, collecteurs Kubernetes, hôtes, télémétrie interne) restent
  # indexées en mapping OTel natif.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/connector/routingconnector
  routing/metrics:
    error_mode: ignore
    default_pipelines: [metrics/elasticsearch]
    table:
      - context: metric
        condition: IsMatch(instrumentation_scope.name, "^io\\.opentelemetry\\.")
        pipelines: [metrics/apm]

exporters:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlphttpexporter
  otlphttp/apm-server:
    endpoint: "{{ apm_server_url }}"
    headers:
      Authorization: "Bearer ${env:APM_SERVER_SECRET_TOKEN}"
    # File persistante (ADR-013) : les traces acquittées au receiver Kafka
    # survivent à un redémarrage du collecteur et à une panne d'APM Server.
    # Pleine, la file refuse les données : le receiver Kafka ne marque pas
    # le message et le relit, Kafka reste le tampon.
    sending_queue:
      enabled: true
      storage: file_storage
      sizer: requests
      queue_size: 1000
      batch:
        flush_timeout: 1s
        sizer: items
        min_size: 512
    # Réessais sans limite de durée : seule une erreur permanente (4xx hors
    # 429) abandonne un lot.
    retry_on_failure:
      enabled: true
      initial_interval: 1s
      max_interval: 30s
      max_elapsed_time: 0s
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/elasticsearchexporter
  # Mode de mapping OTel natif (défaut de l'exporteur) pour tous les signaux
  # indexés ici : les data streams prennent le suffixe .otel, par exemple
  # logs-supermarche.otel-homologation (ADR-012). Aucun flux n'est forcé en
  # ECS ; les traces et les métriques de l'agent Java OTel passent par APM
  # Server et gardent son modèle (ADR-016).
  elasticsearch/otel:
    endpoints: ["{{ elasticsearch_url }}"]
    api_key: ${env:ELASTICSEARCH_API_KEY}
    sending_queue:
      enabled: true
      queue_size: 1000
      storage: file_storage
    # Réessais explicites (ADR-013) : erreurs de transport et 429. Les 5xx ne
    # sont pas réessayés, pour éviter les doublons d'un bulk partiellement
    # indexé.
    retry:
      enabled: true
      max_retries: 10
      initial_interval: 1s
      max_interval: 1m
      retry_on_status: [429]

service:
  extensions: [health_check, file_storage]
  # Télémétrie interne (ADR-013) : niveau normal, export toutes les 30 s,
  # logs au niveau info (défaut), sans traces. La ressource remplace le
  # processor resource/internal-telemetry : data stream
  # metrics|logs-collectortelemetry.otel-{{ otel_environment }}, instance
  # stable. Cette télémétrie ne passe pas par Kafka : la plateforme et
  # l'environnement de la VM sont posés ici (ADR-015).
  telemetry:
    resource:
      attributes:
        - name: service.name
          value: otel-backend
        - name: service.version
          value: "{{ elastic_agent_version }}"
        - name: service.instance.id
          value: "{{ inventory_hostname }}"
        - name: host.name
          value: "{{ inventory_hostname }}"
        - name: deployment.environment.name
          value: "{{ otel_environment }}"
        - name: platform.id
          value: "{{ otel_platform }}"
        - name: data_stream.dataset
          value: collectortelemetry
        - name: data_stream.namespace
          value: "{{ otel_environment }}"
    metrics:
      level: normal
      readers:
        - periodic:
            interval: 30000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, cumulativetodelta, batch]
      exporters: [elasticsearch/otel]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, batch]
      exporters: [elasticsearch/otel]
    traces:
      receivers: [kafka/otlp]
      processors: [memory_limiter, resource/kafka-topic, transform/data-stream-route]
      exporters: [otlphttp/apm-server]
    metrics:
      receivers: [kafka/otlp]
      processors: [memory_limiter, filter/invalid-double, resource/kafka-topic, transform/data-stream-route, cumulativetodelta]
      exporters: [routing/metrics]
    metrics/apm:
      receivers: [routing/metrics]
      processors: [transform/apm-metrics]
      exporters: [otlphttp/apm-server]
    metrics/elasticsearch:
      receivers: [routing/metrics]
      exporters: [elasticsearch/otel]
    logs:
      receivers: [kafka/otlp]
      processors: [memory_limiter, resource/kafka-topic, transform/data-stream-route]
      exporters: [elasticsearch/otel]
