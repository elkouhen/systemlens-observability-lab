extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 0.0.0.0:13134
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/otel

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/kafkareceiver
  kafka/otlp:
    brokers: ["{{ otel_kafka_broker }}"]
    protocol_version: 3.9.0
    group_id: otel-backend
    # Souscription par expression régulière (un topic commençant par « ^ »
    # est interprété comme une regex) : le backend consomme le topic de base
    # d'un signal et toute déclinaison « <topic>-<suffixe> », par exemple
    # otel-logs-equipe-a. Les nouveaux topics sont découverts à chaque
    # rafraîchissement des métadonnées, sans redémarrage du collecteur.
    traces:
      topics: ["^otel-traces(-.+)?$"]
      encoding: otlp_proto
    metrics:
      topics: ["^otel-metrics(-.+)?$"]
      encoding: otlp_proto
    logs:
      topics: ["^otel-logs(-.+)?$"]
      encoding: otlp_proto
    # Une partition sans offset commité (topic nouvellement découvert) est
    # lue depuis le début : les premiers messages publiés avant la découverte
    # ne sont pas perdus. Les partitions déjà commitées reprennent à leur offset.
    initial_offset: earliest
    metadata:
      refresh_interval: 1m
    auth:
      sasl:
        username: "${env:OTEL_KAFKA_CONSUMER_USERNAME}"
        password: "${env:OTEL_KAFKA_CONSUMER_PASSWORD}"
        mechanism: PLAIN

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:4322

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 700
    spike_limit_mib: 150
  cumulativetodelta:
    include:
      metric_types:
        - histogram
  batch:
    timeout: 1s
    send_batch_size: 512
  # Routage par topic (ADR-007, ADR-010) : un topic suffixé
  # otel-<signal>-<suffixe> porte un flux routé par l'Edge, dont le dataset est
  # déjà posé (ou laissé à la source). Son namespace de data stream est
  # l'environnement de la ressource (deployment.environment.name, sinon
  # deployment.environment, sinon « default »). Le receiver Kafka expose le
  # topic d'origine dans le contexte de la requête (kafka.topic) ; il est copié
  # en attribut de ressource avant le batch, qui ne conserve pas ce contexte.
  # Le topic de base (sans suffixe) ne pose aucun namespace : la valeur fournie
  # par la source ou « default » s'applique.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/resourceprocessor
  resource/kafka-topic:
    attributes:
      - key: otel.kafka.topic
        from_context: metadata.kafka.topic
        action: upsert
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/data-stream-namespace:
    error_mode: ignore
    log_statements: &data_stream_namespace
      # L'environnement est normalisé (minuscules, caractères [a-z0-9_]) pour
      # respecter les contraintes de nommage des data streams.
      - context: resource
        conditions:
          - IsMatch(resource.attributes["otel.kafka.topic"], "^otel-(logs|metrics|traces)-.+$")
        statements:
          - set(resource.attributes["data_stream.namespace"], "default")
          - set(resource.attributes["data_stream.namespace"], resource.attributes["deployment.environment"]) where resource.attributes["deployment.environment"] != nil
          - set(resource.attributes["data_stream.namespace"], resource.attributes["deployment.environment.name"]) where resource.attributes["deployment.environment.name"] != nil
          - set(resource.attributes["data_stream.namespace"], ConvertCase(resource.attributes["data_stream.namespace"], "lower"))
          - replace_pattern(resource.attributes["data_stream.namespace"], "[^a-z0-9_]", "_")
      - context: resource
        statements:
          - delete_key(resource.attributes, "otel.kafka.topic")
          - delete_key(resource.attributes, "otel.route.dataset")
    metric_statements: *data_stream_namespace
    # APM Server impose les datasets apm, apm.error et apm.* : le namespace
    # des traces d'une route applicative porte donc aussi l'application,
    # <dataset de la route>_<environnement> (ADR-010, note du 2026-11-02).
    # Le dataset de la route arrive de l'Edge dans otel.route.dataset. Le
    # namespace est recopié dans apm.route.namespace : APM Server en fait le
    # label global apm_route_namespace, reporté sur ses métriques agrégées, que
    # le pipeline Elasticsearch apm-route-namespace range dans ce namespace
    # puis retire de tous les documents APM.
    trace_statements:
      - context: resource
        statements:
          # Seul ce collecteur pose le label de routage des agrégats.
          - delete_key(resource.attributes, "apm.route.namespace")
      - context: resource
        conditions:
          - IsMatch(resource.attributes["otel.kafka.topic"], "^otel-traces-.+$")
        statements:
          - set(resource.attributes["data_stream.namespace"], "default")
          - set(resource.attributes["data_stream.namespace"], resource.attributes["deployment.environment"]) where resource.attributes["deployment.environment"] != nil
          - set(resource.attributes["data_stream.namespace"], resource.attributes["deployment.environment.name"]) where resource.attributes["deployment.environment.name"] != nil
          - set(resource.attributes["data_stream.namespace"], Concat([resource.attributes["otel.route.dataset"], resource.attributes["data_stream.namespace"]], "_")) where resource.attributes["otel.route.dataset"] != nil
          - set(resource.attributes["data_stream.namespace"], ConvertCase(resource.attributes["data_stream.namespace"], "lower"))
          - replace_pattern(resource.attributes["data_stream.namespace"], "[^a-z0-9_]", "_")
          - set(resource.attributes["apm.route.namespace"], resource.attributes["data_stream.namespace"]) where resource.attributes["otel.route.dataset"] != nil
      - context: resource
        statements:
          - delete_key(resource.attributes, "otel.kafka.topic")
          - delete_key(resource.attributes, "otel.route.dataset")
  resource/internal-telemetry:
    attributes:
      - key: data_stream.dataset
        value: collectortelemetry
        action: upsert
      - key: service.name
        value: otel-backend
        action: upsert
      - key: service.version
        value: "{{ otel_collector_contrib_version }}"
        action: upsert
      - key: service.instance.id
        value: "{{ inventory_hostname }}"
        action: upsert

exporters:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlphttpexporter
  otlphttp/apm-server:
    endpoint: "{{ apm_server_url }}"
    headers:
      Authorization: "Bearer ${env:APM_SERVER_SECRET_TOKEN}"
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/elasticsearchexporter
  # Mode de mapping OTel natif (défaut de l'exporteur) pour tous les signaux
  # indexés ici : les data streams prennent le suffixe .otel, par exemple
  # logs-supermarche.otel-homologation (ADR-012). Aucun flux n'est forcé en
  # ECS ; les traces passent par APM Server et gardent son modèle.
  elasticsearch/otel:
    endpoints: ["{{ elasticsearch_url }}"]
    api_key: ${env:ELASTICSEARCH_API_KEY}
    sending_queue:
      enabled: true
      queue_size: 1000
      storage: file_storage

service:
  extensions: [health_check, file_storage]
  telemetry:
    resource:
      service.name: otel-backend
      deployment.environment.name: homologation
    metrics:
      level: detailed
      readers:
        - periodic:
            interval: 3000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
        - pull:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/prometheusexporter
              prometheus:
                host: 0.0.0.0
                port: 8889
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
    traces:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:4322
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, cumulativetodelta, batch]
      exporters: [elasticsearch/otel]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [elasticsearch/otel]
    traces/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [elasticsearch/otel]
    traces:
      receivers: [kafka/otlp]
      processors: [memory_limiter, resource/kafka-topic, transform/data-stream-namespace, batch]
      exporters: [otlphttp/apm-server]
    metrics:
      receivers: [kafka/otlp]
      processors: [memory_limiter, resource/kafka-topic, transform/data-stream-namespace, cumulativetodelta, batch]
      exporters: [elasticsearch/otel]
    logs:
      receivers: [kafka/otlp]
      processors: [memory_limiter, resource/kafka-topic, transform/data-stream-namespace, batch]
      exporters: [elasticsearch/otel]
