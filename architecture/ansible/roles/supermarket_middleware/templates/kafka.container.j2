[Unit]
Description=Kafka KRaft lab
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/apache/kafka:3.9.2
ContainerName=observability-kafka
Network=host
Volume=kafka-data:/tmp/kraft-combined-logs:Z
Volume=/var/log/kafka:/opt/kafka/logs:Z
Environment=CLUSTER_ID={{ kafka_cluster_id }}
Environment=KAFKA_NODE_ID=1
Environment=KAFKA_PROCESS_ROLES=broker,controller
Environment=KAFKA_LISTENERS=INTERNAL://:9092,DOCKER://:19092,CONTROLLER://:9093
Environment=KAFKA_ADVERTISED_LISTENERS=INTERNAL://{{ node_ip }}:9092,DOCKER://{{ node_ip }}:19092
Environment=KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
Environment=KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,INTERNAL:PLAINTEXT,DOCKER:PLAINTEXT
Environment=KAFKA_INTER_BROKER_LISTENER_NAME=INTERNAL
Environment=KAFKA_CONTROLLER_QUORUM_VOTERS={{ kafka_controller_voters }}
Environment=KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
Environment=KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
Environment=KAFKA_DEFAULT_REPLICATION_FACTOR=1
Environment=KAFKA_MIN_INSYNC_REPLICAS=1
Environment=KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
Environment=KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
# Rétention par défaut des messages ; les overrides de topic restent prioritaires.
Environment=KAFKA_LOG_RETENTION_HOURS=24
Environment=KAFKA_LOG_RETENTION_BYTES=536870912
Environment=KAFKA_LOG_ROLL_HOURS=1
Environment=KAFKA_LOG_SEGMENT_BYTES=67108864
Environment=KAFKA_LOG_CLEANUP_POLICY=delete
Environment=KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000
Environment=KAFKA_LOG_DIRS=/tmp/kraft-combined-logs
Environment=KAFKA_HEAP_OPTS=-Xms256m -Xmx256m

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
