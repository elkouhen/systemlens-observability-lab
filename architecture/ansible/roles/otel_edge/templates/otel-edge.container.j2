[Unit]
Description=Collecteur OpenTelemetry Contrib Edge du lab
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/otel/opentelemetry-collector-contrib:{{ otel_collector_contrib_version }}
ContainerName=observability-otel-edge
EnvironmentFile=/etc/observability/otel-edge.env
Network=host
Volume=/etc/observability/otel-edge.yaml:/etc/otel/collector.yaml:ro,Z
Volume=/etc/observability/otel-edge.tokens:/etc/otel/edge.tokens:ro,Z
Volume=/var/lib/observability/otel-edge:/var/lib/otel-edge:Z
Exec=--config=/etc/otel/collector.yaml

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
