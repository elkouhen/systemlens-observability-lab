extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/bearertokenauth
  bearertokenauth/clients:
    filename: /etc/otel/edge.tokens
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 0.0.0.0:13135
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/otel-edge

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:14317
        auth:
          authenticator: bearertokenauth/clients
      http:
        endpoint: 127.0.0.1:14318
        auth:
          authenticator: bearertokenauth/clients

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:14319

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 500
    spike_limit_mib: 100
  batch:
    timeout: 1s
    send_batch_size: 512
  batch/logs:
    timeout: 1s
    send_batch_size: 50
    send_batch_max_size: 50
  resource/internal-telemetry:
    attributes:
      - key: data_stream.dataset
        value: collectortelemetry
        action: upsert
      - key: service.name
        value: otel-edge
        action: upsert
      - key: service.version
        value: "{{ otel_collector_contrib_version }}"
        action: upsert
      - key: service.instance.id
        value: "{{ inventory_hostname }}"
        action: upsert

{#
  Routage par topic (ADR-009). Le topic est choisi par ressource et posé dans
  l'attribut otel.kafka.topic, lu par topic_from_attribute de l'exporteur
  Kafka. Une ressource sans cet attribut part dans le topic de base.
  Les logs suivent le namespace Kubernetes de leur pod : la règle applicative
  passe avant le marqueur Kubernetes. Les métriques et les traces suivent leur
  émetteur : le marqueur posé par les collecteurs Kubernetes passe avant.
  Les logs et métriques d'une route applicative reçoivent le dataset de
  l'application (ADR-010) ; les traces gardent le dataset apm d'APM Server.
#}
{% macro kafka_topic_statements(signal) %}
      - context: resource
        statements:
          # Un client ne choisit jamais lui-même son topic.
          - delete_key(resource.attributes, "otel.kafka.topic")
{% if signal != 'logs' %}
          - set(resource.attributes["otel.kafka.topic"], "otel-{{ signal }}-{{ otel_edge_kubernetes_kafka_topic_suffix }}") where resource.attributes["otel.edge.source"] == "kubernetes"
{% endif %}
{% for route in otel_edge_application_routes %}
          - set(resource.attributes["otel.kafka.topic"], "otel-{{ signal }}-{{ route.kafka_topic_suffix }}") where resource.attributes["otel.kafka.topic"] == nil and resource.attributes["k8s.namespace.name"] == "{{ route.kubernetes_namespace }}"
{% endfor %}
{% if signal == 'logs' %}
          - set(resource.attributes["otel.kafka.topic"], "otel-{{ signal }}-{{ otel_edge_kubernetes_kafka_topic_suffix }}") where resource.attributes["otel.kafka.topic"] == nil and resource.attributes["otel.edge.source"] == "kubernetes"
{% endif %}
{% if signal != 'traces' %}
{% for route in otel_edge_application_routes %}
          - set(resource.attributes["data_stream.dataset"], "{{ route.data_stream_dataset }}") where resource.attributes["otel.kafka.topic"] == "otel-{{ signal }}-{{ route.kafka_topic_suffix }}"
{% endfor %}
{% endif %}
          # Le marqueur des collecteurs Kubernetes n'est pas indexé.
          - delete_key(resource.attributes, "otel.edge.source")
{% endmacro %}
  # Choix du topic Kafka et du dataset par ressource (ADR-009, ADR-010).
  # otel.kafka.topic reste sur la ressource jusqu'à l'exporteur ; le backend le
  # réécrit depuis le topic lu puis le supprime avant l'indexation (ADR-007).
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/kafka-topic:
    error_mode: ignore
    trace_statements:
{{ kafka_topic_statements('traces') | trim('\n') }}
    metric_statements:
{{ kafka_topic_statements('metrics') | trim('\n') }}
    log_statements:
{{ kafka_topic_statements('logs') | trim('\n') }}
exporters:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/kafkaexporter
  kafka/otlp:
    brokers: ["{{ otel_gateway_kafka_broker }}"]
    auth:
      sasl:
        username: "${env:OTEL_KAFKA_PUBLISHER_USERNAME}"
        password: "${env:OTEL_KAFKA_PUBLISHER_PASSWORD}"
        mechanism: PLAIN
    # Topic posé par transform/kafka-topic ; à défaut, topic de base du signal.
    # L'exporteur publie chaque ressource séparément dans son topic.
    topic_from_attribute: otel.kafka.topic
    traces:
      topic: otel-traces
      encoding: otlp_proto
    metrics:
      topic: otel-metrics
      encoding: otlp_proto
    logs:
      topic: otel-logs
      encoding: otlp_proto

service:
  extensions: [health_check, file_storage, bearertokenauth/clients]
  telemetry:
    resource:
      service.name: otel-edge
      deployment.environment.name: homologation
    metrics:
      level: detailed
      readers:
        - periodic:
            interval: 3000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
    traces:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [kafka/otlp]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch/logs]
      exporters: [kafka/otlp]
    traces/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [kafka/otlp]
    traces:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, batch]
      exporters: [kafka/otlp]
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, batch]
      exporters: [kafka/otlp]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, batch/logs]
      exporters: [kafka/otlp]
