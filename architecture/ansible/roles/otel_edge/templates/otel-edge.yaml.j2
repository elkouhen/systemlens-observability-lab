extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/bearertokenauth
  bearertokenauth/clients:
    filename: /etc/otel/edge.tokens
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 0.0.0.0:13135
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/otel-edge

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp:
    protocols:
      grpc:
        endpoint: 127.0.0.1:14317
        auth:
          authenticator: bearertokenauth/clients
      http:
        endpoint: 127.0.0.1:14318
        auth:
          authenticator: bearertokenauth/clients

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:14319

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 500
    spike_limit_mib: 100
  batch:
    timeout: 1s
    send_batch_size: 512
  batch/logs:
    timeout: 1s
    send_batch_size: 50
    send_batch_max_size: 50

{#
  Choix du topic par ressource (ADR-015). Le topic porte la plateforme et
  l'environnement, otel-<signal>-<plateforme>-<environnement> ; le backend en
  tire platform.id et data_stream.namespace. Les tables viennent de
  inventory/group_vars/otel_edge_nodes.yml (cluster, namespaces) et de
  l'inventaire des VM (hôtes dont otel_edge désigne cet Edge) ; routes.yml
  valide leur format.
  1. Un client ne choisit jamais son topic ni ses attributs de data stream :
     otel.kafka.topic, data_stream.namespace, apm.route.namespace et
     platform.id reçus sont supprimés, ainsi que data_stream.dataset, sauf
     collectortelemetry que les agents EDOT et les collecteurs posent sur
     leur télémétrie interne.
  2. Marqueur otel.edge.source=kubernetes des collecteurs Kubernetes : les
     métriques et les traces suivent leur émetteur et vont dans la plateforme
     du cluster avant la règle des namespaces, car les métriques kubeletstats
     d'un pod applicatif portent le namespace du pod. Les logs suivent le
     namespace de leur pod : le marqueur passe après.
  3. Namespace Kubernetes connu (celui des collecteurs, puis les plateformes
     hébergées) : topic de sa plateforme.
  4. host.name d'une VM rattachée : topic de sa plateforme.
  5. Dataset d'une route applicative sur les logs et les métriques de son
     namespace, jamais sur les traces (APM Server impose apm).
     k8s.cluster.name du cluster sur toute ressource Kubernetes. Le marqueur
     n'est pas indexé. Le backend tire du topic platform.id,
     data_stream.namespace et deployment.environment.name.
  Une ressource sans topic est rejetée ensuite par filter/unrouted.
#}
{% set cluster_route = {'kubernetes_namespace': otel_edge_cluster.kubernetes_namespace, 'platform': otel_edge_cluster.platform, 'environment': otel_edge_cluster.environment, 'dataset': 'receiver'} %}
{% set namespace_routes = [cluster_route] + otel_edge_namespace_routes %}
{% macro kafka_topic_statements(signal) %}
{% set cluster_topic = 'otel-' ~ signal ~ '-' ~ otel_edge_cluster.platform ~ '-' ~ otel_edge_cluster.environment %}
      - context: resource
        statements:
          - delete_key(resource.attributes, "otel.kafka.topic")
          - delete_key(resource.attributes, "data_stream.namespace")
          - delete_key(resource.attributes, "apm.route.namespace")
          - delete_key(resource.attributes, "platform.id")
          - delete_key(resource.attributes, "data_stream.dataset") where resource.attributes["data_stream.dataset"] != "collectortelemetry"
{% if signal != 'logs' %}
          - set(resource.attributes["otel.kafka.topic"], "{{ cluster_topic }}") where resource.attributes["otel.edge.source"] == "kubernetes"
{% endif %}
{% for route in namespace_routes %}
          - set(resource.attributes["otel.kafka.topic"], "otel-{{ signal }}-{{ route.platform }}-{{ route.environment }}") where resource.attributes["otel.kafka.topic"] == nil and resource.attributes["k8s.namespace.name"] == "{{ route.kubernetes_namespace }}"
{% endfor %}
{% if signal == 'logs' %}
          - set(resource.attributes["otel.kafka.topic"], "{{ cluster_topic }}") where resource.attributes["otel.kafka.topic"] == nil and resource.attributes["otel.edge.source"] == "kubernetes"
{% endif %}
{% for host in otel_edge_hosts %}
          - set(resource.attributes["otel.kafka.topic"], "otel-{{ signal }}-{{ hostvars[host].otel_platform }}-{{ hostvars[host].otel_environment }}") where resource.attributes["otel.kafka.topic"] == nil and resource.attributes["host.name"] == "{{ host }}"
{% endfor %}
{% if signal != 'traces' %}
{% for route in otel_edge_namespace_routes if route.dataset != 'receiver' %}
          - set(resource.attributes["data_stream.dataset"], "{{ route.dataset }}") where resource.attributes["otel.kafka.topic"] == "otel-{{ signal }}-{{ route.platform }}-{{ route.environment }}" and resource.attributes["k8s.namespace.name"] == "{{ route.kubernetes_namespace }}"
{% endfor %}
{% endif %}
          - set(resource.attributes["k8s.cluster.name"], "{{ otel_edge_cluster.name }}") where resource.attributes["k8s.namespace.name"] != nil or resource.attributes["otel.edge.source"] == "kubernetes"
          # Le marqueur des collecteurs Kubernetes n'est pas indexé.
          - delete_key(resource.attributes, "otel.edge.source")
{% endmacro %}
  # Topic Kafka par ressource, depuis les tables de routage (ADR-015).
  # otel.kafka.topic reste sur la ressource jusqu'à l'exporteur ; le backend
  # le réécrit depuis le topic lu, puis le supprime avant l'indexation.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/kafka-topic:
    error_mode: ignore
    trace_statements:
{{ kafka_topic_statements('traces') | trim('\n') }}
    metric_statements:
{{ kafka_topic_statements('metrics') | trim('\n') }}
    log_statements:
{{ kafka_topic_statements('logs') | trim('\n') }}
  # Rejet des ressources hors tables (ADR-015) : ni namespace Kubernetes
  # connu, ni marqueur des collecteurs, ni host.name d'une VM rattachée. Les
  # compteurs otelcol_processor_filter_{logs,datapoints,spans}_filtered de ce
  # collecteur rendent l'oubli visible (make otel-routing-verify).
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/filterprocessor
  filter/unrouted:
    error_mode: ignore
    traces:
      span:
        - resource.attributes["otel.kafka.topic"] == nil
    metrics:
      metric:
        - resource.attributes["otel.kafka.topic"] == nil
    logs:
      log_record:
        - resource.attributes["otel.kafka.topic"] == nil
  # Nom des spans HTTP client (ADR-011). La convention sémantique HTTP nomme un
  # span client « {méthode} » seul, faute de gabarit d'URL : l'appel
  # order-service → inventory-service apparaît comme « POST ». Ce processor
  # renomme en « {méthode} {chemin normalisé} » tout span CLIENT qui porte
  # url.full et dont le nom se réduit encore à la méthode (ou « HTTP » pour
  # une méthode inconnue) ; un nom déjà plus précis, les spans base de données,
  # Kafka et serveur ne sont pas modifiés. Le chemin est tiré de url.full,
  # sans schéma, hôte, port, requête ni fragment ; vide, il vaut « / ».
  # Normalisation, pour borner la cardinalité des noms : un segment
  # identifiant devient {id}. Est identifiant un segment entièrement
  # numérique, un UUID, une suite hexadécimale d'au moins 16 caractères, ou un
  # code en majuscules, chiffres, « - » et « _ » contenant au moins un chiffre
  # (PASTA-500G). Un segment en minuscules comme v1 ou api est conservé. La
  # règle est appliquée deux fois : une passe consomme la barre qui suit un
  # identifiant et saute donc un identifiant sur deux d'une suite contiguë.
  # Les attributs (url.full, http.request.method, server.address) ne changent
  # pas : APM Server en tire toujours span.destination.service.resource.
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/processor/transformprocessor
  transform/http-client-span-name:
    error_mode: ignore
    trace_statements:
      - context: span
        conditions:
          - span.kind == SPAN_KIND_CLIENT and span.attributes["url.full"] != nil and (span.name == span.attributes["http.request.method"] or span.name == "HTTP")
        statements:
          - set(span.cache["path"], span.attributes["url.full"])
          - replace_pattern(span.cache["path"], "^[a-zA-Z][a-zA-Z0-9+.-]*://[^/?#]*", "")
          - replace_pattern(span.cache["path"], "[?#].*$", "")
          - set(span.cache["path"], "/") where span.cache["path"] == ""
          - replace_pattern(span.cache["path"], "/([0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|[A-Z0-9_-]*[0-9][A-Z0-9_-]*)(/|$)", "/{id}$$2")
          - replace_pattern(span.cache["path"], "/([0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}|[0-9a-fA-F]{16,}|[A-Z0-9_-]*[0-9][A-Z0-9_-]*)(/|$)", "/{id}$$2")
          - set(span.name, Concat([span.name, span.cache["path"]], " "))
exporters:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/exporter/kafkaexporter
  kafka/otlp:
    brokers: ["{{ otel_gateway_kafka_broker }}"]
    auth:
      sasl:
        username: "${env:OTEL_KAFKA_PUBLISHER_USERNAME}"
        password: "${env:OTEL_KAFKA_PUBLISHER_PASSWORD}"
        mechanism: PLAIN
    # Topic posé par transform/kafka-topic, une ressource par topic, encodage
    # otlp_proto par défaut. Les topics par défaut de l'exporteur ne
    # reçoivent rien : filter/unrouted rejette avant toute ressource sans
    # topic (ADR-015).
    topic_from_attribute: otel.kafka.topic

service:
  extensions: [health_check, file_storage, bearertokenauth/clients]
  # Télémétrie interne (ADR-013) : niveau normal, export toutes les 30 s,
  # logs au niveau info (défaut), sans traces. La ressource remplace le
  # processor resource/internal-telemetry ; host.name la fait router par la
  # table des VM vers la plateforme de cette VM (ADR-015), avec le dataset
  # collectortelemetry conservé.
  telemetry:
    resource:
      attributes:
        - name: service.name
          value: otel-edge
        - name: service.version
          value: "{{ elastic_agent_version }}"
        - name: service.instance.id
          value: "{{ inventory_hostname }}"
        - name: host.name
          value: "{{ inventory_hostname }}"
        - name: data_stream.dataset
          value: collectortelemetry
    metrics:
      level: normal
      readers:
        - periodic:
            interval: 30000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:14319
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch/logs]
      exporters: [kafka/otlp]
    traces:
      receivers: [otlp]
      processors: [memory_limiter, transform/http-client-span-name, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    metrics:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch]
      exporters: [kafka/otlp]
    logs:
      receivers: [otlp]
      processors: [memory_limiter, transform/kafka-topic, filter/unrouted, batch/logs]
      exporters: [kafka/otlp]
