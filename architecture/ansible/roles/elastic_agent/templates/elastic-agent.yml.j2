agent:
  grpc:
    port: 6790

{% set internal_telemetry_port = 4320 if node_role == 'otel_edge' else 4317 %}

extensions:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/healthcheckextension
  health_check:
    endpoint: 127.0.0.1:13136
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/storage/filestorage
  file_storage:
    directory: /var/lib/observability/elastic-agent-otel
    create_directory: true
{% if fleet_enrollment_token | default('') | length > 0 %}
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/extension/opampextension
  opamp:
    server:
      http:
        endpoint: http://{{ elk_ip }}:8220/v1/opamp
        headers:
          Authorization: ApiKey {{ fleet_enrollment_token }}
    instance_uid: "{{ opamp_instance_uid }}"
    agent_description:
      non_identifying_attributes:
        elastic.collector.group_name: "SystemLens VM"
        elastic.collector.group: "systemlens-vm"
        elastic.display.name: "{{ inventory_hostname }}"
{% endif %}

receivers:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/receiver/otlpreceiver
  otlp/internal:
    protocols:
      grpc:
        endpoint: 127.0.0.1:{{ internal_telemetry_port }}

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/filelogreceiver
  filelog/system:
    include:
      - /var/log/messages
      - /var/log/secure
      - /var/log/*.log
{% if node_role in ['poc', 'otel_backend'] %}
      - /var/log/kafka/*.log
{% endif %}
{% if node_role == 'poc' %}
      - /var/log/mongodb/mongod.log
      - /var/log/postgresql/*.log
{% endif %}
    start_at: end
    include_file_path: true
    operators:
      - type: move
        from: body
        to: attributes.message

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/hostmetricsreceiver
  hostmetrics/system:
    root_path: /
    collection_interval: 30s
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization:
            enabled: true
      load:
      memory:
        metrics:
          system.memory.utilization:
            enabled: true
      disk:
      filesystem:
      network:
      paging:
      processes:

{% if node_role in ['poc', 'otel_backend'] %}
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/kafkametricsreceiver
  kafkametrics/local:
    brokers:
      - 127.0.0.1:9092
    protocol_version: 3.9.0
    scrapers:
      - brokers
      - topics
      - consumers
    collection_interval: 60s

{% endif %}
{% if node_role == 'poc' %}
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/mongodbreceiver
  mongodb/poc:
    hosts:
      - endpoint: 127.0.0.1:27017
    username: {{ mongodb_otel_user }}
    password: {{ mongodb_otel_password }}
    collection_interval: 60s
    initial_delay: 5s
    direct_connection: true
    tls:
      insecure: true

  # Documentation : https://github.com/open-telemetry/opentelemetry-collector-contrib/tree/main/receiver/postgresqlreceiver
  postgresql/poc:
    endpoint: 127.0.0.1:5432
    username: {{ postgresql_otel_user }}
    password: {{ postgresql_otel_password }}
    databases:
      - {{ postgresql_database }}
    collection_interval: 30s
    initial_delay: 5s
    metrics:
      postgresql.blks_hit: {enabled: true}
      postgresql.blks_read: {enabled: true}
      postgresql.database.locks: {enabled: true}
      postgresql.deadlocks: {enabled: true}
      postgresql.sequential_scans: {enabled: true}
      postgresql.temp_files: {enabled: true}
      postgresql.temp.io: {enabled: true}
      postgresql.tup_deleted: {enabled: true}
      postgresql.tup_fetched: {enabled: true}
      postgresql.tup_inserted: {enabled: true}
      postgresql.tup_returned: {enabled: true}
      postgresql.tup_updated: {enabled: true}
      postgresql.wal.delay: {enabled: true}
      postgresql.function.calls: {enabled: true}
    events:
      db.server.query_sample: {enabled: true}
      db.server.top_query: {enabled: true}
    query_sample_collection:
      max_rows_per_query: 100
    top_query_collection:
      max_rows_per_query: 100
      top_n_query: 200
      max_explain_each_interval: 1000
      query_plan_cache_size: 1000
      query_plan_cache_ttl: 1h
    tls:
      insecure: true
{% endif %}

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 300
    spike_limit_mib: 75
  batch:
    timeout: 5s
    send_batch_size: 256
  resource/agent:
    attributes:
      - key: service.name
        value: elastic-agent-otel
        action: upsert
      - key: deployment.environment.name
        value: homologation
        action: upsert
      - key: host.name
        value: {{ inventory_hostname }}
        action: upsert
  resource/internal-telemetry:
    attributes:
      - key: data_stream.dataset
        value: collectortelemetry
        action: upsert
      - key: service.name
        value: elastic-otel-collector
        action: upsert
      - key: service.version
        value: {{ elastic_agent_version }}
        action: upsert
      - key: service.instance.id
        value: "{{ opamp_instance_uid | default(inventory_hostname) }}"
        action: upsert
      - key: service.namespace
        value: systemlens-vm
        action: upsert
      - key: elastic.collector.group_name
        value: SystemLens VM
        action: upsert
      - key: elastic.collector.group
        value: systemlens-vm
        action: upsert
      - key: elastic.display.name
        value: {{ inventory_hostname }}
        action: upsert
  attributes/mongodb:
    actions:
      - key: mongodb.instance
        value: 127.0.0.1:27017
        action: upsert

exporters:
  # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlphttpexporter
  otlphttp/edge:
    endpoint: http://{{ otel_edge_ip }}:4318

service:
  extensions: [health_check, file_storage{% if fleet_enrollment_token | default('') | length > 0 %}, opamp{% endif %}]
  telemetry:
    metrics:
      level: detailed
      readers:
        - periodic:
            interval: 3000
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:{{ internal_telemetry_port }}
    logs:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:{{ internal_telemetry_port }}
    traces:
      processors:
        - batch:
            exporter:
              # Documentation : https://github.com/open-telemetry/opentelemetry-collector/tree/main/exporter/otlpexporter
              otlp:
                protocol: grpc
                endpoint: http://127.0.0.1:{{ internal_telemetry_port }}
    resource:
      data_stream.dataset: collectortelemetry
      service.name: elastic-otel-collector
      service.version: "{{ elastic_agent_version }}"
      service.instance.id: "{{ opamp_instance_uid | default(inventory_hostname) }}"
      service.namespace: systemlens-vm
      elastic.collector.group_name: SystemLens VM
      elastic.collector.group: systemlens-vm
      elastic.display.name: {{ inventory_hostname }}
  pipelines:
    metrics/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [otlphttp/edge]
    logs/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [otlphttp/edge]
    traces/internal-telemetry:
      receivers: [otlp/internal]
      processors: [memory_limiter, resource/internal-telemetry, batch]
      exporters: [otlphttp/edge]
    logs:
      receivers: [filelog/system]
      processors: [memory_limiter, resource/agent, batch]
      exporters: [otlphttp/edge]
    metrics:
      receivers: [hostmetrics/system{% if node_role in ['poc', 'otel_backend'] %}, kafkametrics/local{% endif %}{% if node_role == 'poc' %}, postgresql/poc{% endif %}]
      processors: [memory_limiter, resource/agent, batch]
      exporters: [otlphttp/edge]
{% if node_role == 'poc' %}
    metrics/mongodb:
      receivers: [mongodb/poc]
      processors: [memory_limiter, resource/agent, attributes/mongodb, batch]
      exporters: [otlphttp/edge]
    logs/postgresql:
      receivers: [postgresql/poc]
      processors: [memory_limiter, resource/agent, batch]
      exporters: [otlphttp/edge]
{% endif %}
