[Unit]
Description=Kibana du lab
After=network-online.target observability-elasticsearch.service
Wants=network-online.target
Requires=observability-elasticsearch.service

[Container]
# Documentation : https://www.elastic.co/docs/deploy-manage/deploy/self-managed/install-kibana-with-docker
Image=docker.elastic.co/kibana/kibana:9.5.4
ContainerName=observability-kibana
Network=host
EnvironmentFile=/etc/observability/kibana.env
Volume=/etc/observability/kibana.yml:/usr/share/kibana/config/kibana.yml:ro,Z
Environment=NODE_OPTIONS=--max-old-space-size=1024
{% if zscaler_ca_cert_content | length > 0 %}
# Proxy TLS d'entreprise (optionnel, ZSCALER_CA_CERT) : Node.js n'utilise pas
# le magasin de certificats de la VM ; sans cette racine, Fleet ne peut pas
# joindre le registre public des packages (epr.elastic.co).
Volume={{ '/usr/local/share/ca-certificates/zscaler-root-ca.crt' if ansible_os_family == 'Debian' else '/etc/pki/ca-trust/source/anchors/zscaler-root-ca.crt' }}:/usr/share/kibana/config/zscaler-root-ca.crt:ro
Environment=NODE_EXTRA_CA_CERTS=/usr/share/kibana/config/zscaler-root-ca.crt
{% endif %}

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
