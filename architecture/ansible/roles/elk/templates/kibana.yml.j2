# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/general-settings
server.host: 0.0.0.0
server.port: 5601
server.publicBaseUrl: http://kibana.observability.test:5601
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/general-settings
elasticsearch.hosts: ["http://127.0.0.1:9200"]
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/security-settings
xpack.encryptedSavedObjects.encryptionKey: "{{ kibana_encryption_key }}"
xpack.security.encryptionKey: "{{ kibana_security_key }}"
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/reporting-settings
xpack.reporting.encryptionKey: "{{ kibana_reporting_key }}"
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/fleet-settings
xpack.fleet.agents.enabled: true
xpack.fleet.agents.fleet_server.hosts: ["http://fleet.observability.test:8220"]
xpack.fleet.registryUrl: https://epr.elastic.co
# Documentation : https://www.elastic.co/docs/reference/fleet/install-uninstall-integration-assets
xpack.fleet.packages:
  - name: fleet_server
    version: 1.2.0
  # Packages conservés pour leurs assets Kibana uniquement. Aucune package
  # policy ne les attache aux agents EDOT standalone.
  - name: system
    version: 1.20.4
  - name: mongodb
    version: 1.5.0
  - name: kafka
    version: 1.3.0
  - name: postgresql
    version: 1.5.0
  - name: kubernetes_otel
    version: 2.6.1
  - name: kafka_otel
    version: 0.3.1
  - name: postgresql_otel
    version: 0.5.0
  - name: mongodb_otel
    version: 0.3.1
  - name: system_otel
    version: 0.3.0
  - name: otel_collector_internal_telemetry
    version: 1.2.3
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/fleet-settings
# Les agents VM restent standalone. Cette policy ne contient aucune package
# policy de collecte ; elle sert uniquement à l'enregistrement OpAMP.
xpack.fleet.agentPolicies:
  - id: eck-fleet-server
    name: Fleet Server
    namespace: default
    monitoring_enabled: [logs, metrics]
    is_default_fleet_server: true
    package_policies:
      - id: fleet-server-1
        name: fleet-server-1
        namespace: default
        package:
          name: fleet_server
        inputs:
          fleet_server-fleet-server:
            enabled: true
  - id: otel-fleet
    name: OTel standalone — supervision OpAMP
    namespace: default
    monitoring_enabled: [logs, metrics]
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/telemetry-settings
telemetry.optIn: false
telemetry.allowChangingOptInStatus: false
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/logging-settings
logging:
  appenders:
    json:
      type: console
      layout:
        type: json
  root:
    appenders: [json]
    level: info
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/security-settings
xpack.security.audit.enabled: true
xpack.security.audit.appender:
  type: console
  layout:
    type: json
# Documentation : https://www.elastic.co/docs/reference/kibana/configuration-reference/task-manager-settings
xpack.task_manager.monitored_stats_health_verbose_log.enabled: true
