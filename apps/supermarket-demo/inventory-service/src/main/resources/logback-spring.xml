<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="co.elastic.logging.logback.EcsEncoder">
            <serviceName>${ECS_SERVICE_NAME}</serviceName>
            <serviceEnvironment>${ECS_SERVICE_ENVIRONMENT}</serviceEnvironment>
            <serviceVersion>${ECS_SERVICE_VERSION}</serviceVersion>
            <serviceNodeName>${ECS_SERVICE_NODE_NAME}</serviceNodeName>
            <eventDataset>${ECS_EVENT_DATASET}</eventDataset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
