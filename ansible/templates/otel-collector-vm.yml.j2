# EDOT local à data-01 : ce profil remplace intégralement Filebeat, Metricbeat
# et Elastic Agent/Fleet pour les logs et métriques de cet hôte.
extensions:
  file_storage:
    directory: /var/lib/otelcol/file-storage

receivers:
  host_metrics:
    collection_interval: 30s
    root_path: /hostfs
    scrapers:
      cpu:
        metrics:
          system.cpu.utilization:
            enabled: true
          system.cpu.logical.count:
            enabled: true
      load: {}
      memory:
        metrics:
          system.memory.utilization:
            enabled: true
      network: {}
      filesystem:
        exclude_mount_points:
          match_type: regexp
          mount_points:
            - ^/(sys|cgroup|proc|dev|etc|host|lib|snap)($|/)
  mongodb:
    hosts:
      - endpoint: 127.0.0.1:27017
    replica_set: {{ mongodb_replica_set }}
    collection_interval: 60s
  kafka_metrics:
    brokers: ["127.0.0.1:9092"]
    cluster_alias: poc-kafka
    collection_interval: 60s
    scrapers: [brokers, topics, consumers]
  postgresql:
    endpoint: 127.0.0.1:5432
    username: {{ postgresql_user }}
    password: {{ postgresql_password }}
    databases: [{{ postgresql_database }}]
    collection_interval: 60s
    tls:
      insecure: true
  filelog/system:
    include: [/hostfs/var/log/messages*, /hostfs/var/log/secure*]
    exclude: [/hostfs/var/log/*.gz]
    start_at: end
    storage: file_storage
  filelog/mongodb:
    include: [/hostfs/var/log/mongodb/mongod.log]
    start_at: end
    storage: file_storage
  filelog/kafka:
    include: [/hostfs/var/log/kafka/*.log]
    start_at: end
    storage: file_storage
  filelog/postgresql:
    include: [/hostfs/var/log/postgresql/*.log]
    start_at: end
    storage: file_storage

processors:
  memory_limiter:
    check_interval: 1s
    limit_mib: 128
    spike_limit_mib: 32
  resource_detection:
    detectors: [env, system]
    timeout: 2s
  resource/vm:
    attributes:
      # Le collecteur s'exécute dans un conteneur : imposer l'identité de la VM
      # évite de publier le nom du conteneur comme hôte observé.
      - key: host.name
        value: {{ inventory_hostname }}
        action: upsert
      - key: deployment.environment.name
        value: poc
        action: upsert
  resource/log-system:
    attributes:
      - key: service.name
        value: system
        action: upsert
  resource/log-mongodb:
    attributes:
      - key: service.name
        value: mongodb
        action: upsert
  resource/log-kafka:
    attributes:
      - key: service.name
        value: kafka
        action: upsert
  resource/log-postgresql:
    attributes:
      - key: service.name
        value: postgresql
        action: upsert
  batch:
    timeout: 5s

exporters:
  elasticsearch/infra:
    endpoints: ["{{ elasticsearch_url }}"]
    # L'exporter Elasticsearch attend `id:api_key` encodé Base64.
    api_key: {{ elasticsearch_api_key | b64encode }}
    pipeline: otel-hostmetrics-dashboard-compat
    tls:
      ca_file: /etc/otel/ca/ca-bundle.pem
    sending_queue:
      enabled: true
      num_consumers: 2
      queue_size: 1000

service:
  extensions: [file_storage]
  pipelines:
    metrics/vm:
      receivers: [host_metrics, mongodb, kafka_metrics, postgresql]
      processors: [memory_limiter, resource_detection, resource/vm, batch]
      exporters: [elasticsearch/infra]
    logs/system:
      receivers: [filelog/system]
      processors: [memory_limiter, resource_detection, resource/vm, resource/log-system, batch]
      exporters: [elasticsearch/infra]
    logs/mongodb:
      receivers: [filelog/mongodb]
      processors: [memory_limiter, resource_detection, resource/vm, resource/log-mongodb, batch]
      exporters: [elasticsearch/infra]
    logs/kafka:
      receivers: [filelog/kafka]
      processors: [memory_limiter, resource_detection, resource/vm, resource/log-kafka, batch]
      exporters: [elasticsearch/infra]
    logs/postgresql:
      receivers: [filelog/postgresql]
      processors: [memory_limiter, resource_detection, resource/vm, resource/log-postgresql, batch]
      exporters: [elasticsearch/infra]
