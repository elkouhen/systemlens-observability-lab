metricbeat.modules:
  - module: system
    period: 30s
    metricsets: [cpu, load, memory, network, process_summary, uptime]
  - module: system
    period: 1m
    metricsets: [filesystem, fsstat]
    processors:
      - drop_event.when.regexp:
          system.filesystem.mount_point: '^/(sys|cgroup|proc|dev|etc|host|lib|snap)($|/)'
  - module: mongodb
    period: 60s
    hosts: ["mongodb://127.0.0.1:27017"]
    metricsets: [collstats, dbstats, metrics, replstatus, status]
  - module: kafka
    period: 60s
    hosts: ["127.0.0.1:9092"]
    metricsets: [broker, partition, consumergroup]
processors:
  - add_host_metadata: ~

output.elasticsearch:
  hosts: ["{{ elasticsearch_url }}"]
  api_key: "{{ elasticsearch_api_key }}"
  ssl.certificate_authorities: ["/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem"]
