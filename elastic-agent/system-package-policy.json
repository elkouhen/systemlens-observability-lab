{
  "name": "system-fleet",
  "description": "Metriques et journaux systeme des VMs data-01 a data-03",
  "namespace": "default",
  "policy_ids": ["mongodb-hosts"],
  "package": {"name": "system", "title": "System", "version": "2.22.4"},
  "inputs": [
    {
      "type": "system/metrics",
      "policy_template": "system",
      "enabled": true,
      "streams": [
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.cpu"}, "vars": {"period": {"type": "text", "value": "30s"}, "cpu.metrics": {"type": "text", "value": ["percentages"]}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.memory"}, "vars": {"period": {"type": "text", "value": "30s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.load"}, "vars": {"period": {"type": "text", "value": "30s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.network"}, "vars": {"period": {"type": "text", "value": "30s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.process.summary"}, "vars": {"period": {"type": "text", "value": "30s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.uptime"}, "vars": {"period": {"type": "text", "value": "30s"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.filesystem"}, "vars": {"period": {"type": "text", "value": "1m"}, "processors": {"type": "yaml", "value": "- drop_event.when.regexp:\n    system.filesystem.mount_point: ^/(sys|cgroup|proc|dev|etc|host|lib|snap)($|/)"}}},
        {"enabled": true, "data_stream": {"type": "metrics", "dataset": "system.fsstat"}, "vars": {"period": {"type": "text", "value": "1m"}, "processors": {"type": "yaml", "value": "- drop_event.when.regexp:\n    system.fsstat.mount_point: ^/(sys|cgroup|proc|dev|etc|host|lib|snap)($|/)"}}}
      ]
    },
    {
      "type": "logfile",
      "policy_template": "system",
      "enabled": true,
      "streams": [
        {"enabled": true, "data_stream": {"type": "logs", "dataset": "system.syslog"}, "vars": {"paths": {"type": "text", "value": ["/var/log/messages*"]}, "exclude_files": {"type": "text", "value": ["\\.gz$"]}, "preserve_original_event": {"type": "bool", "value": false}}},
        {"enabled": true, "data_stream": {"type": "logs", "dataset": "system.auth"}, "vars": {"paths": {"type": "text", "value": ["/var/log/secure*"]}, "exclude_files": {"type": "text", "value": ["\\.gz$"]}, "preserve_original_event": {"type": "bool", "value": false}}}
      ]
    }
  ]
}
