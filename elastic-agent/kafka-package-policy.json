{
  "name": "kafka-fleet",
  "description": "Metriques Kafka KRaft du POC via Podman et Jolokia (logs gérés par Filebeat)",
  "namespace": "default",
  "policy_ids": ["mongodb-hosts"],
  "package": {
    "name": "kafka",
    "title": "Kafka",
    "version": "1.27.2"
  },
  "inputs": [
    {
      "type": "logfile",
      "policy_template": "kafka",
      "enabled": false,
      "streams": [
        {
          "enabled": true,
          "data_stream": {"type": "logs", "dataset": "kafka.log"},
          "vars": {
            "kafka_home": {"type": "text", "value": "/var/log/kafka"},
            "paths": {"type": "text", "value": ["/*.log*"]},
            "tags": {"type": "text", "value": ["kafka-log"]},
            "preserve_original_event": {"type": "bool", "value": false}
          }
        }
      ]
    },
    {
      "type": "kafka/metrics",
      "policy_template": "kafka",
      "enabled": true,
      "vars": {
        "hosts": {"type": "text", "value": ["localhost:9092"]},
        "period": {"type": "text", "value": "60s"}
      },
      "streams": [
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.broker"},
          "vars": {"jolokia_hosts": {"type": "text", "value": ["http://127.0.0.1:8778"]}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.partition"},
          "vars": {}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.consumergroup"},
          "vars": {}
        }
      ]
    },
    {
      "type": "jolokia/metrics",
      "policy_template": "kafka",
      "enabled": true,
      "vars": {
        "hosts": {"type": "text", "value": ["http://127.0.0.1:8778"]},
        "metrics_path": {"type": "text", "value": "/jolokia"},
        "http_method": {"type": "text", "value": "GET"}
      },
      "streams": [
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.controller"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.jvm"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.network"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.log_manager"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.replica_manager"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.topic"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        },
        {
          "enabled": true,
          "data_stream": {"type": "metrics", "dataset": "kafka.raft"},
          "vars": {"period": {"type": "text", "value": "60s"}}
        }
      ]
    }
  ]
}
